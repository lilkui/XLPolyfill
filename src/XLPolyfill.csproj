<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ExcelAddInExplicitExports>true</ExcelAddInExplicitExports>
    <ExcelAddInInclude>$(MSBuildProjectDirectory)\..\vendor\ExcelDna.Loader\ExcelDna.Loader.dll</ExcelAddInInclude>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="XLPolyfill.Tests" />
    <PackageReference Include="ExcelDna.AddIn" Version="1.9.0" />
    <PackageReference Include="ExcelDna.IntelliSense" Version="1.9.0" />
  </ItemGroup>

</Project>
