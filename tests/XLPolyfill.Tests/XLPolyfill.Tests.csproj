<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\XLPolyfill.csproj" />
    <Compile Include="..\XLPolyfill.ExcelSmoke\LoaderProbe.cs" Link="LoaderProbe.cs" />
    <None Include="$(PkgExcelDna_AddIn)\tools\net6.0-windows7.0\ExcelDna.AddIn.Tasks.dll"
          Link="ExcelDna.AddIn.Tasks.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyPackedAddIns" AfterTargets="CopyFilesToOutputDirectory">
    <Copy SourceFiles="@(_ResolvedProjectReferencePaths->'%(RelativeDir)publish\%(Filename)-AddIn-packed.xll');
                       @(_ResolvedProjectReferencePaths->'%(RelativeDir)publish\%(Filename)-AddIn64-packed.xll')"
          DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true">
      <Output TaskParameter="CopiedFiles" ItemName="FileWrites" />
    </Copy>
  </Target>

</Project>
